# ---------------------------------------------------------------------------
# Agentic BI — environment configuration
# Copy to .env and fill in values. Never commit real secrets.
# ---------------------------------------------------------------------------

# development | test | production
ENVIRONMENT=development
DEBUG=false

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
COOKIE_SECURE=false
# Only needed if the browser calls the API cross-origin (normally the Next proxy is used).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=240
LOGIN_RATE_LIMIT_PER_MINUTE=20

# --- Database --------------------------------------------------------------
# Local default (SQLite, zero setup):
DATABASE_URL=sqlite:///apps/api/data/agentic_bi.db
# Production (PostgreSQL 15+ with pgvector):
# DATABASE_URL=postgresql+psycopg2://agentic:agentic@postgres:5432/agentic_bi
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# --- PostgreSQL container (docker compose only) ----------------------------
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic
POSTGRES_DB=agentic_bi
POSTGRES_PORT=5432

# --- Object storage --------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=apps/api/data/storage
# STORAGE_BACKEND=s3
# S3_BUCKET=agentic-bi
# S3_REGION=eu-west-1
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Analytical engine -----------------------------------------------------
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=2
QUERY_TIMEOUT_SECONDS=15
QUERY_ROW_LIMIT=5000
MAX_UPLOAD_BYTES=52428800
MAX_EXCEL_SHEETS=25

# --- Background jobs -------------------------------------------------------
# Leave USE_CELERY=false for single-process local runs (thread pool fallback).
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
JOB_MAX_RETRIES=2

# --- AI --------------------------------------------------------------------
# Without a key the platform runs in deterministic mode: real SQL, rule-based
# planning, deterministic narrative composition and hashed embeddings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2
LLM_ENABLED=true
EMBEDDING_DIM=256
# Optional tracing
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Agentic BI
# Origin the Next.js server proxies /api/v1 to (server-side only).
BACKEND_URL=http://127.0.0.1:8000

# --- End-to-end tests (Playwright) ----------------------------------------
E2E_BASE_URL=http://127.0.0.1:3000
E2E_EMAIL=demo@agenticbi.dev
E2E_PASSWORD=DemoPass123!
